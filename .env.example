# Flask
# LOSTFOUND_SECRET_KEY=change-me-to-a-long-random-string
# LOSTFOUND_SECURE_COOKIES=0
# PORT=5057
# LOSTFOUND_DB=lostfound.db
# LOSTFOUND_BASE_URL=http://127.0.0.1:5057

# Optional OpenAI refinement (local refiner is used when unset)
# OPENAI_API_KEY=
# OPENAI_REFINE_MODEL=gpt-4o-mini

# SMTP (required for real email verification / password reset)
# LOSTFOUND_SMTP_HOST=
# LOSTFOUND_SMTP_PORT=587
# LOSTFOUND_SMTP_USER=
# LOSTFOUND_SMTP_PASSWORD=
# LOSTFOUND_SMTP_FROM=
# LOSTFOUND_SMTP_TLS=true
